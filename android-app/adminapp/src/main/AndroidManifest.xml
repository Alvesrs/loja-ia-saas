<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:label="Agente SaintsAI"
        android:theme="@style/AppTheme"
        android:icon="@drawable/guru_icon_default"
        android:roundIcon="@drawable/guru_icon_default">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
        </activity>
    <activity-alias android:name=".IconDefault" android:targetActivity=".MainActivity" android:enabled="true" android:exported="true" android:icon="@drawable/guru_icon_default" android:label="Agente SaintsAI"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
<activity-alias android:name=".IconLight" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/guru_icon_light" android:label="Agente SaintsAI"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
<activity-alias android:name=".IconGold" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/guru_icon_gold" android:label="Agente SaintsAI"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
<activity-alias android:name=".IconMint" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true" android:icon="@drawable/guru_icon_mint" android:label="Agente SaintsAI"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity-alias>
</application>
</manifest>
