ARG NODE_BASE_IMAGE=public.ecr.aws/docker/library/node:22-bookworm
FROM ${NODE_BASE_IMAGE}
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*
COPY . .
RUN node -e 'const {execSync}=require("node:child_process");const {build}=require("./railway.json");const cmds=build.buildCommand.split(" && ").filter(s=>!/^node (?:--test )?tests\//.test(s));execSync(cmds.join(" && "),{stdio:"inherit",shell:"/bin/sh"})'
# The legacy ZIP overwrites tests; final validation must use the branch versions.
COPY tests/ ./tests/
ENV NODE_ENV=production
RUN node patches/stability-confirmed-send-v1.js && node patches/stability-send-intent-v1.js && node patches/stability-commercial-boundary-v1.js && node patches/stability-auto-context-v1.js && node patches/stability-meta-batch-v1.js && node patches/stability-handoff-session-v1.js && node patches/stability-waha-durable-batch-v1.js && node patches/stability-waha-atomic-v2.js && node patches/stability-interface-v7.js && node patches/stability-serialized-claim-v1.js && node patches/stability-tenant-human-v1.js && node patches/stability-operation-status-v1.js && node patches/stability-startup-side-effects-v1.js && node patches/stability-subscription-access-v1.js && node patches/stability-booking-confirmation-v1.js && node patches/stability-test-plan-selection-v1.js && node patches/stability-prospect-consent-v1.js && node patches/stability-contact-identity-v1.js && node patches/stability-personal-media-boundary-v1.js && node patches/stability-receipt-net-value-v1.js && node patches/stability-manual-prospect-consent-v1.js && node patches/stability-theme-bootstrap-v1.js && node patches/premium-interface-v8.js && node --test tests/manual-prospect-consent.test.cjs tests/theme-bootstrap.test.cjs tests/receipt-net-value.test.cjs tests/owner-opening-mode.test.cjs tests/prospect-webhook-isolation.test.js tests/delivery-location.test.cjs tests/legalPages.test.js tests/stability-owner-consultative.test.cjs tests/owner-contact-alias.test.cjs tests/contact-identity.test.cjs tests/owner-refusal-send.test.cjs tests/pwa.test.js tests/release12a.test.js tests/prospect-consent.test.cjs tests/prospect-consent-rounds.test.cjs tests/owner-subscription-test.test.js tests/service-save-concurrency.test.cjs tests/booking-confirmation-idempotency.test.cjs tests/admin-notify-whatsapp.test.js tests/client-interface-v7.test.cjs tests/client-access-delivery.test.js tests/startup-side-effects.test.cjs tests/operation-status.test.cjs tests/tenant-human-control.test.cjs tests/owner-reply-recovery.test.cjs tests/waha-durable-ack.test.cjs tests/handoff-session-isolation.test.cjs tests/meta-batch-durability.test.cjs tests/current-tenant-isolation.test.cjs tests/automatic-context-recovery.test.cjs tests/prospect-attendance-isolation.test.js tests/commercial-boundary.test.cjs tests/owner-sales-continuity.test.cjs tests/send-intent.test.cjs tests/queue-durable-recovery.test.cjs tests/owner-minute-handoff.test.cjs tests/atendimento-hibrido-worker.test.js tests/stability-confirmed-send.test.cjs tests/owner-star-control.test.cjs tests/auto-prospect.test.cjs tests/release-payments.test.cjs tests/release-account-care.test.cjs tests/sale-notification-retry.test.cjs
CMD ["npm","start"]
# Build uses ECR mirror instead of Docker Hub
