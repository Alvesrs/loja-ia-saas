ARG NODE_BASE_IMAGE=public.ecr.aws/docker/library/node:22-bookworm
FROM ${NODE_BASE_IMAGE}
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*
COPY . .
RUN node -e 'const {execSync}=require("node:child_process");const {build}=require("./railway.json");const cmds=build.buildCommand.split(" && ").filter(s=>!/^node (?:--test )?tests\//.test(s));execSync(cmds.join(" && "),{stdio:"inherit",shell:"/bin/sh"})'
ENV NODE_ENV=production
RUN node patches/stability-confirmed-send-v1.js && node patches/stability-send-intent-v1.js && node patches/stability-commercial-boundary-v1.js && node patches/stability-auto-context-v1.js && node patches/stability-meta-batch-v1.js && node patches/stability-handoff-session-v1.js && node patches/stability-waha-durable-batch-v1.js && node patches/stability-waha-atomic-v2.js && node patches/stability-interface-v7.js && node patches/stability-serialized-claim-v1.js && node --test tests/owner-reply-recovery.test.cjs tests/waha-durable-ack.test.cjs tests/handoff-session-isolation.test.cjs tests/meta-batch-durability.test.cjs tests/current-tenant-isolation.test.cjs tests/automatic-context-recovery.test.cjs tests/prospect-attendance-isolation.test.js tests/commercial-boundary.test.cjs tests/owner-sales-continuity.test.cjs tests/send-intent.test.cjs tests/queue-durable-recovery.test.cjs tests/owner-minute-handoff.test.cjs tests/atendimento-hibrido-worker.test.js tests/stability-confirmed-send.test.cjs tests/owner-star-control.test.cjs tests/auto-prospect.test.cjs tests/release-payments.test.cjs tests/release-account-care.test.cjs tests/sale-notification-retry.test.cjs
CMD ["npm","start"]
# Build uses ECR mirror instead of Docker Hub
